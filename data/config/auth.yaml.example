# sail-jinx authentication — copy to auth.yaml and fill in.
#
#   cp data/config/auth.yaml.example data/config/auth.yaml
#
# auth.yaml holds a client secret and is in .gitignore. THIS file is committed and
# must never contain a real one. If you paste a secret here by mistake, treat it as
# leaked: revoke it in the Google Cloud console and issue a new one.
#
# The examples below are for the first deployment, https://myc.mortbay.org, running
# on the club Raspberry Pi alongside sailing-pf. See etc/install.sh.

# Off by default. With this false, or with no auth.yaml at all, sail-jinx behaves as
# it always has: no login, every request an admin. That is fine for the club PC on
# one desk. It is not fine for anything reachable over a network.
enabled: false

# --- Google Workspace ------------------------------------------------------
#
# In the Google Cloud console — https://console.cloud.google.com — signed in as a
# club Workspace administrator, with a project owned by the club:
#
#   1. Audience / OAuth consent screen:
#         https://console.cloud.google.com/auth/audience
#      (older consoles: https://console.cloud.google.com/apis/credentials/consent —
#      Google renamed this area "Google Auth Platform"; both links land in the same
#      place.) Set User type to "Internal". That alone restricts sign-in to the club
#      Workspace, and this file's allowedDomain is then a second, independent check
#      rather than the only one. "Internal" is only offered on a Workspace account —
#      if it is greyed out, the project is not owned by the club's Workspace.
#
#   2. Clients / Credentials:
#         https://console.cloud.google.com/auth/clients
#      (older: https://console.cloud.google.com/apis/credentials)
#      Create client > application type "Web application".
#   3. Authorised redirect URI: the address the RACE OFFICER'S BROWSER uses, plus
#      redirectPath below. Google matches it as a literal string, so it must agree
#      exactly — scheme, host, port and path.
#
#         https://myc.mortbay.org/auth/callback
#
#      Add one line per address the server is reached on.
#
#      *** IT MUST BE https. *** Google rejects a plain http:// redirect URI for a
#      web application; the only exception is http://localhost. So the Pi needs a
#      TLS certificate before sign-in can work at all — in practice a reverse proxy
#      (nginx or Caddy) terminating Let's Encrypt in front of this server. That is
#      worth having anyway: the session cookie this login issues is as good as the
#      password, and over plain http anyone on the path can read it.
#
#      Behind that proxy, set `forwardedHeaders: true` under `server:` in
#      config.yaml, or the server builds its redirect_uri from its own address and
#      sends Google to http://localhost:8080/auth/callback instead.
#
#   4. Copy the client ID and secret here.

issuer: "https://accounts.google.com"
clientId: "000000000000-xxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com"
clientSecret: "REPLACE-ME"

# Where Google sends the browser back. Must match the registered redirect URI.
redirectPath: "/auth/callback"

# Only Workspace accounts in this domain may sign in. Checked server-side against
# the `hd` claim Google returns, and against the address. Leave it out to admit any
# account the issuer will authenticate — which for Google means any Gmail account,
# so do not leave it out.
#
# Note this is the club's EMAIL domain, which need not be the address the server is
# reached at: people sign in as someone@myc.org.au to use https://myc.mortbay.org.
allowedDomain: "myc.org.au"

# Who may edit handicaps and unlock races. Everyone else who signs in can still run
# a race night — enter times, results, flags — but not rewrite the season.
# An empty list means everyone who can sign in is an admin.
admins:
  - "commodore@myc.org.au"

# --- When sign-in fails ----------------------------------------------------
#
# Google sends the browser back to redirectPath and the server refuses it. The page
# you land on names the reason, and the same line is logged at WARN — on the Pi,
# `journalctl -u sail-jinx -f`. What the common ones mean:
#
#   invalid_client            The clientSecret here is not the one the console holds.
#                             Regenerating the secret in the console invalidates the
#                             old one immediately; paste the new one and restart.
#   redirect_uri_mismatch     The Authorised redirect URI does not match what the
#                             server built. Google matches the whole string — scheme,
#                             host, port, path. Behind a proxy this is nearly always
#                             `forwardedHeaders: false` in config.yaml, which makes
#                             the server build http://... from its own address.
#   invalid_grant             The authorisation code was already used or has expired.
#                             Usually a reloaded callback URL or a bookmarked one —
#                             start again from the site root.
#   invalid state parameter   The callback does not belong to any sign-in this server
#                             started. Restarting the server discards its sessions, so
#                             a login begun before a restart lands here; so does a tab
#                             left open for hours. Start again from the site root.
#
# Turning on the OpenID debug log gets the whole exchange, and it does not print the
# secret. Add to src/main/resources/jetty-logging.properties and restart:
#
#   org.eclipse.jetty.security.openid.LEVEL=DEBUG

# Treat requests from this machine as an admin without signing in.
#
# For the club PC where the browser and the server are the same computer: it keeps
# race night working during an internet outage, when Google cannot be reached and
# nobody could sign in.
#
# DANGEROUS behind a reverse proxy, which is how myc.mortbay.org is served. Nginx,
# Caddy or a cloud load balancer connects from 127.0.0.1, so every request in the
# world would arrive as loopback and this would exempt all of them. Leave it false
# for the Pi.
allowLoopback: false
